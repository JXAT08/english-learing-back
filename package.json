{
  "name": "englishtech-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.16",
    "openai": "6.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "9.35.0",
    "@types/node": "24.5.2",
    "@vercel/node": "5.3.24",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vercel": "48.1.6",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
