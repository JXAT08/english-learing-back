# Copia este archivo como .env (ignorado por Git). En Render, estos valores van
# en Environment del servicio englishtech-api.

# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Orígenes del frontend permitidos por CORS, separados por comas (sin barra final).
ALLOWED_ORIGINS=http://localhost:5173,https://english-learing-web-eight.vercel.app

# Tutor IA (api/tutor.ts, se migra a la nueva arquitectura en la fase B6)
OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna
ALLOWED_ORIGIN=http://localhost:5173
